# ==============================================================================
# CivicShield — Git ignore rules
# Keep source, SQL schema/seed/migrations, tests, and documentation under version control.
# Exclude local secrets, runtime data, generated audits, and temporary work files.
# ==============================================================================

# ----------------------------------------------------------------------
# Local environment and secrets
# ----------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
config.local.php

# ----------------------------------------------------------------------
# Application logs and runtime output
# ----------------------------------------------------------------------
/logs/*
!/logs/.gitkeep
*.log

# ----------------------------------------------------------------------
# User-uploaded/runtime files
# Keep the upload security rule and empty directory placeholders.
# ----------------------------------------------------------------------
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess
!/uploads/avatars/
/uploads/avatars/*
!/uploads/avatars/.gitkeep
!/uploads/incidents/
/uploads/incidents/*
!/uploads/incidents/.gitkeep

# ----------------------------------------------------------------------
# Generated audit output and local review artifacts
# ----------------------------------------------------------------------
/CivicShield-Audit/
/CivicShield-backup-*/
/CivicShield-security-review.patch
/civicshield-design-system-attempt.css
/civicshield-redesign-attempt.patch

# ----------------------------------------------------------------------
# Scratch and local backup files
# ----------------------------------------------------------------------
/backup/
/scratch/
*.bak
*.tmp
*.temp
*.orig
*.rej
*~

# ----------------------------------------------------------------------
# Database dumps/backups (keep database/schema.sql, seed.sql, migrations)
# ----------------------------------------------------------------------
*.sql.gz
*.sql.zip
*.dump
*.backup
db_backup*.sql
/database/backups/
/database/dumps/

# ----------------------------------------------------------------------
# Operating system files
# ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ----------------------------------------------------------------------
# IDE/editor artifacts
# ----------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ----------------------------------------------------------------------
# Generic temporary/cache/coverage artifacts
# ----------------------------------------------------------------------
/tmp/
/cache/
.phpunit.cache/
coverage/
*.cache
