# ==============================================================================
# CivicShield Platform - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment (e.g. XAMPP)
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=true
APP_NAME="CivicShield: Privacy-Preserving Civic Incident Intelligence Platform"
APP_URL=http://localhost/OEP

# Database Connection (MySQL 8 / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=civicshield_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
CSRF_SECRET_KEY=change_this_to_a_random_32_character_string_for_production

# Privacy & Obfuscation Configuration
GEO_FUZZING_ENABLED=true
GEO_FUZZ_RADIUS_METERS=150

# Upload Limits (in bytes, 5MB = 5242880)
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# Duplicate Incident Candidate Detection (Phase 6)
DUPLICATE_CANDIDATE_RADIUS_METERS=50
DUPLICATE_SCORE_THRESHOLD=50.0
